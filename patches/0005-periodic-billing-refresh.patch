+// BillingEvery 解析 schedule.billing_interval，返回周期余额刷新间隔。
+// 返回 0 表示不启用（schedule.billing_enabled=false）。
+func (s *Schedule) BillingEvery() (time.Duration, error) {
+	if !s.BillingEnabled {
+		return 0, nil
+	}
+	raw := strings.TrimSpace(s.BillingInterval)
